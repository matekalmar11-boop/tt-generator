{
  "name": "tt-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio",
    "typecheck": "tsc --noEmit",
    "still": "remotion still src/index.ts Main out/frame.png --frame=130 --gl=swangle",
    "render": "remotion render src/index.ts Main out/tiktok-fantasy.mp4 --gl=swangle --concurrency=4 --audio-codec=aac --crf=20",
    "story": "tsx tools/story.ts",
    "story:check": "tsx tools/story.ts check",
    "test:story": "tsx tools/test-resolve.ts",
    "story:compare": "node scripts/compare-stills.mjs",
    "tts:setup": "bash tts/setup.sh",
    "voice": "tsx tools/story.ts voice"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@remotion/cli": "^4.0.540",
    "@remotion/three": "^4.0.540",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.540",
    "three": "^0.187.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
