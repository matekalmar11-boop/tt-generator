{
  "name": "tt-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio",
    "typecheck": "tsc --noEmit",
    "still": "remotion still src/index.ts TikTokTest out/frame.png --frame=130 --gl=swangle",
    "render": "remotion render src/index.ts TikTokTest out/tiktok-test.mp4 --gl=swangle --concurrency=4"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@remotion/cli": "^4.0.540",
    "@remotion/three": "^4.0.540",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.540",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2"
  }
}
