    },
    "maxFontSize": {
     "default": 104,
     "type": "integer",
     "minimum": -9007199254740991,
     "maximum": 9007199254740991
    },
    "bottomPadding": {
     "default": 560,
     "description": "Abstand der Untertitel zum unteren Bildrand (px bei 1920 hoch; TikTok-UI beachten).",
