{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "schema": {
   "type": "number",
   "const": 1,
   "description": "Schema-Version."
  },
  "meta": {
   "type": "object",
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
     "type": "string",
     "minLength": 1
    },
    "language": {
     "default": "de",
     "type": "string",
     "const": "de"
    },
    "genre": {
     "type": "string"
    },
    "description": {
     "type": "string"
    },
    "targetDuration": {
     "description": "Soll-Länge in Sekunden; check warnt bei Abweichung.",
     "type": "object",
     "properties": {
      "min": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "max": {
       "type": "number",
       "exclusiveMinimum": 0
      }
     },
     "required": [
      "min",
      "max"
     ],
     "additionalProperties": false
    }
   },
   "required": [
    "id",
    "title"
   ],
   "additionalProperties": false
  },
  "format": {
   "default": {
    "fps": 30,
    "width": 1080,
    "height": 1920
   },
   "type": "object",
   "properties": {
    "fps": {
     "default": 30,
     "type": "integer",
     "minimum": 15,
     "maximum": 60
    },
    "width": {
     "default": 1080,
     "type": "integer",
     "minimum": 270,
     "maximum": 9007199254740991
    },
    "height": {
     "default": 1920,
     "type": "integer",
     "minimum": 480,
     "maximum": 9007199254740991
    }
   },
   "additionalProperties": false
  },
  "voices": {
   "type": "object",
   "propertyNames": {
    "type": "string",
    "pattern": "^[A-Za-z][\\w-]*$"
   },
   "additionalProperties": {
    "type": "object",
    "properties": {
     "engine": {
      "default": "piper",
      "description": "TTS-Engine (offline, kostenlos). Aktuell nur Piper.",
      "type": "string",
      "const": "piper"
     },
     "model": {
      "default": "de_DE-thorsten-medium",
      "description": "Piper-Modellname (Sprache steckt im Modell).",
      "type": "string"
     },
     "lengthScale": {
      "default": 1.08,
      "description": "Sprechtempo: >1 = langsamer.",
      "type": "number",
      "minimum": 0.5,
      "maximum": 2
     },
     "noiseScale": {
      "default": 0.6,
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "noiseW": {
      "default": 0.7,
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "sentenceGap": {
      "default": 0.24,
      "description": "Pause zwischen Sätzen einer Zeile (Sekunden).",
      "type": "number",
      "minimum": 0,
      "maximum": 2
     },
     "loudness": {
      "default": -16,
      "description": "Ziel-Lautheit in LUFS.",
      "type": "number",
      "minimum": -30,
      "maximum": -6
     },
     "effect": {
      "description": "Klangeffekt, z. B. tiefe Drachenstimme. Zeilenlänge bleibt gleich.",
      "type": "object",
      "properties": {
       "pitch": {
        "default": 1,
        "description": "Tonhöhe, 1 = unverändert, <1 = tiefer.",
        "type": "number",
        "minimum": 0.5,
        "maximum": 1.5
       },
       "lowpassHz": {
        "type": "number",
        "minimum": 1000,
        "maximum": 20000
       },
       "eq": {
        "type": "object",
        "properties": {
         "freqHz": {
          "type": "number"
         },
         "gainDb": {
          "type": "number"
         }
        },
        "required": [
         "freqHz",
         "gainDb"
        ],
        "additionalProperties": false
       },
       "echo": {
        "type": "object",
        "properties": {
         "delayMs": {
          "type": "number",
          "minimum": 1
         },
         "decay": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
         }
        },
        "required": [
         "delayMs",
         "decay"
        ],
        "additionalProperties": false
       }
      },
      "additionalProperties": false
     },
     "subtitle": {
      "default": {
       "accent": "#ffd23d"
      },
      "type": "object",
      "properties": {
       "accent": {
        "default": "#ffd23d",
        "description": "Farbe des gerade gesprochenen Wortes.",
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
       },
       "label": {
        "description": "Sprecher-Schild über dem Untertitel.",
        "type": "string"
       }
      },
      "additionalProperties": false
     }
    },
    "additionalProperties": false
   }
  },
  "pronunciations": {
   "description": "Aussprachehilfe: Wort → Schreibweise für die TTS (Schritt 3).",
   "type": "object",
   "propertyNames": {
    "type": "string"
   },
   "additionalProperties": {
    "type": "string"
   }
  },
  "timing": {
   "default": {
    "lineGap": 0.28
   },
   "description": "Pause zwischen Sprechzeilen einer Szene.",
   "type": "object",
   "properties": {
    "lineGap": {
     "default": 0.28,
     "type": "number",
     "minimum": 0,
     "maximum": 3
    }
   },
   "additionalProperties": false
  },
  "cast": {
   "type": "object",
   "propertyNames": {
    "type": "string",
    "pattern": "^[A-Za-z][\\w-]*$"
   },
   "additionalProperties": {
    "type": "object",
    "properties": {
     "rig": {
      "type": "string",
      "pattern": "^[A-Za-z][\\w-]*$",
      "description": "Figurentyp aus der Registry (src/story/registry.ts), z. B. \"finn\", \"dragon\"."
     },
     "name": {
      "type": "string"
     },
     "role": {
      "type": "string"
     },
     "voice": {
      "description": "Stimmenprofil aus \"voices\". Ohne Stimme: stumme Figur.",
      "type": "string",
      "pattern": "^[A-Za-z][\\w-]*$"
     },
     "look": {
      "description": "Aussehen, z. B. {skin, hair, shirt}. Erlaubte Felder je Figurenart: siehe RIGS[...].looks in src/story/registry.ts.",
      "type": "object",
      "propertyNames": {
       "type": "string"
      },
      "additionalProperties": {
       "anyOf": [
        {
         "type": "string",
         "pattern": "^#[0-9a-fA-F]{6}$"
        },
        {
         "type": "number"
        },
        {
         "type": "string"
        },
        {
         "type": "boolean"
        }
       ]
      }
     }
    },
    "required": [
     "rig"
    ],
    "additionalProperties": false
   }
  },
  "audio": {
   "default": {},
   "type": "object",
   "properties": {
    "music": {
     "type": "object",
     "properties": {
      "file": {
       "type": "string",
       "description": "Datei in public/audio (ohne .wav)."
      },
      "volume": {
       "default": 0.5,
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "duck": {
       "default": {
        "depth": 0.3,
        "attack": "6f",
        "release": "12f"
       },
       "type": "object",
       "properties": {
        "depth": {
         "default": 0.3,
         "description": "Absenkung unter Sprache (Lautstärke − depth).",
         "type": "number",
         "minimum": 0,
         "maximum": 1
        },
        "attack": {
         "default": "6f"
        },
        "release": {
         "default": "12f"
        }
       },
       "additionalProperties": false
      },
      "fadeOut": {
       "default": "45f"
      }
