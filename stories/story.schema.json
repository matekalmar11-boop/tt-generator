     "required": [
      "file"
     ],
     "additionalProperties": false
    }
   },
   "additionalProperties": false
  },
  "subtitles": {
   "default": {
    "maxWords": 3,
    "maxChars": 24,
    "font": "Inter",
    "maxFontSize": 104,
    "bottomPadding": 560
